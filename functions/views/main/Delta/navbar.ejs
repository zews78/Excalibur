              <div class="sign-in">
                Logout
              </div>                
            </button>

            </form>
            <% } else { %>
            <a href="/signup" class="sign-in-button">
                <div class="sign-in">Sign Up</div>
            </a>
            <form action="/login" method="GET">
                <button type="submit" class="sign-in-button">
                <div class="sign-in">
                  Login
                </div>                
              </button>
            </form>
            <% } %>
        </div>
    </div>
