<script >
$(document).ready(function() {
  const links = $('.text-statedark');

  links.on('mouseover', function() {
    links.find('.text-statedark-child').hide();
    $(this).find('.text-statedark-child').show();
  });

  links.on('mouseout', function() {
    $(this).find('.text-statedark-child').hide();
  });
});

</script>