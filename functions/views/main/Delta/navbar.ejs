    <div class="instance-parent">
        <div class="text-statedark-parent">
            <div class="text-statedark">
                <div class="text-statedark-child"></div>
                <a class="home" href="/">Home</a>
            </div>
            <div class="text-statedark">
              <div class="text-statedark-child"></div>
                <a class="home" href="/center">Centre</a>
